<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="24dp"
                android:padding="24dp"
                android:backgroundTint="#FFFFFF">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Ім'я та Прізвище -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:weightSum="2">

                    <TextView
                            android:id="@+id/sessionName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Назва сесії"
                            android:paddingStart="12dp"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:layout_marginEnd="8dp" />

                    <TextView
                            android:id="@+id/sessionStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Статус"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#212121" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:gravity="center_vertical">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:dividerPadding="4dp">

                        <TextView
                                android:id="@+id/sessionDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Опис"
                                android:paddingStart="12dp"
                                android:textSize="18sp"
                                android:textColor="#424242"
                                android:layout_marginBottom="6dp" />

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:weightSum="3">

                            <TextView
                                    android:id="@+id/employeeFirstName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:text="Ім'я"
                                    android:paddingStart="12dp"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#212121"
                                    android:layout_marginEnd="8dp" />

                            <TextView
                                    android:id="@+id/employeeLastName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:text="Прізвище"
                                    android:paddingStart="12dp"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#212121"
                                    android:layout_marginEnd="8dp" />

                            <TextView
                                    android:id="@+id/employeeWorkId"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:text="0000"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#212121" />
                        </LinearLayout>

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:weightSum="2">

                            <TextView
                                    android:id="@+id/startTime"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Початок"
                                    android:paddingStart="12dp"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#212121"
                                    android:layout_marginEnd="8dp" />

                            <TextView
                                    android:id="@+id/endTime"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Закінчення"
                                    android:paddingStart="12dp"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#212121"
                                    android:layout_marginEnd="8dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Кругова діаграма -->
        <com.anychart.AnyChartView
                android:id="@+id/any_chart_view"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="24dp" />

        <!-- Кнопки дій -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

            <Button
                    android:id="@+id/btnViewProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Переглянути товари"
                    android:backgroundTint="@color/black"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp"/>

            <Button
                    android:id="@+id/btnEndSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Завершити сесію"
                    android:backgroundTint="@color/black"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp"/>

            <Button
                    android:id="@+id/btnCancelSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Скасувати сесію"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:textColor="@android:color/white"/>

            <Button
                    android:id="@+id/btnReviewResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Підтвердити результати"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
