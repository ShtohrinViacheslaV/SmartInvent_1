<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:background="@drawable/background_list">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

        <!-- QR-код у картці -->
        <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="8dp"
                android:padding="16dp"
                android:backgroundTint="@color/white"
                android:radius="16dp">

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                <ImageView
                        android:id="@+id/img_qr_code"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="QR Code" />

                <TextView
                        android:id="@+id/txt_product_work_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Код роботи: 000"
                        android:textSize="16sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                    <Button
                            android:id="@+id/btn_save_qr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Зберегти"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="@color/primary"
                            android:textColor="@android:color/white" />

                    <Button
                            android:id="@+id/btn_share_qr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Друкувати"
                            android:backgroundTint="@color/primary"
                            android:textColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="24dp"
                android:background="@color/white"
                android:radius="16dp"
                android:elevation="6dp">

            <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                <TableRow>
                    <TextView
                            android:text="Назва товару:"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="8dp" />
                    <TextView
                            android:id="@+id/txt_name"
                            android:text="..."
                            android:textColor="@color/darkGray"
                            android:padding="8dp" />
                </TableRow>

                <TableRow>
                    <TextView
                            android:text="Опис:"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="8dp" />
                    <TextView
                            android:id="@+id/txt_description"
                            android:text="..."
                            android:textColor="@color/darkGray"
                            android:padding="8dp" />
                </TableRow>

                <TableRow>
                    <TextView
                            android:text="Кількість:"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="8dp" />
                    <TextView
                            android:id="@+id/txt_count"
                            android:text="..."
                            android:textColor="@color/darkGray"
                            android:padding="8dp" />
                </TableRow>

                <TableRow>
                    <TextView
                            android:text="Категорія:"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="8dp" />
                    <TextView
                            android:id="@+id/txt_category"
                            android:text="..."
                            android:textColor="@color/darkGray"
                            android:padding="8dp" />
                </TableRow>

                <TableRow>
                    <TextView
                            android:text="Склад:"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="8dp" />
                    <TextView
                            android:id="@+id/txt_storage"
                            android:text="..."
                            android:textColor="@color/darkGray"
                            android:padding="8dp" />
                </TableRow>

            </TableLayout>
        </androidx.cardview.widget.CardView>



        <!-- Кнопки -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

            <Button
                    android:id="@+id/btn_edit_product"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Редагувати"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp" />

            <Button
                    android:id="@+id/btn_back"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Назад"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
