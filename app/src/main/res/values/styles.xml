<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CardImageStyle">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">@drawable/image_border_gradient</item>
    </style>


    <style name="NeonCardStyle">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">10dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:foreground">@drawable/ripple_effect</item>
    </style>

    <style name="NeonCardStyle1">
        <item name="cardCornerRadius">15dp</item>
        <item name="cardElevation">10dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:foreground">@drawable/ripple_effect</item>
    </style>

    <style name="NeonCardStyleSmall">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:foreground">@drawable/ripple_effect</item>
    </style>

    <style name="NeonCardStyleLarge">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">12dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:foreground">@drawable/ripple_effect</item>
    </style>

    <style name="NeonImageStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">@drawable/image_border_gradient</item>
    </style>


</resources>